# Which AI provider performs OCR on images: openai (default), gemini,
# anthropic, or openrouter.
OCR_PROVIDER=openai

# Model name for the chosen provider. Falls back to OPENAI_MODEL when unset.
OCR_MODEL=gpt-4o-mini

# Maximum tokens in the OCR response. Defaults to 1000.
# OCR_MAX_TOKENS=1000

# Supply the API key for the provider you selected above.
OPENAI_API_KEY=YOUR_API_KEY
# GEMINI_API_KEY=YOUR_API_KEY
# ANTHROPIC_API_KEY=YOUR_API_KEY
# OPENROUTER_API_KEY=YOUR_API_KEY

# Example provider configurations:
#   OCR_PROVIDER=gemini      OCR_MODEL=gemini-2.5-flash
#   OCR_PROVIDER=anthropic   OCR_MODEL=claude-haiku-4-5
#   OCR_PROVIDER=openrouter  OCR_MODEL=google/gemini-2.5-flash
